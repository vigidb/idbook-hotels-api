{
	"info": {
		"_postman_id": "flight-booking-payment-collection",
		"name": "IDBOOK Flight Booking with Payment Integration",
		"description": "Complete flight booking flow including search, pricing, booking, payment processing (Wallet, PhonePe, PayU), and status management",
