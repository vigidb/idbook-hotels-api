{
	"info": {
		"name": "Flight Booking User Flow",
		"description": "Complete flight booking workflow testing including search, hold, payment, confirmation, status updates, cancellation and refunds",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication",
			"item": [
				{
					"name": "Login - Get JWT Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.access) {",
									"        pm.environment.set('access_token', response.access);",
									"        pm.environment.set('refresh_token', response.refresh);",
									"        console.log('Access token set successfully');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"{{test_phone}}\",\n    \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/token/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "token", ""]
						}
					}
				}
			]
		},
		{
			"name": "02. Flight Search",
			"item": [
				{
					"name": "Search Flights",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.offers.length > 0) {",
									"        pm.environment.set('flight_offer', JSON.stringify(response.data.offers[0]));",
									"        pm.environment.set('search_id', response.data.search_id);",
									"        console.log('Flight offer saved for booking');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"origin\": \"DEL\",\n    \"destination\": \"BOM\",\n    \"departure_date\": \"2024-12-25\",\n    \"return_date\": null,\n    \"adults\": 1,\n    \"children\": 0,\n    \"infants\": 0,\n    \"class_type\": \"Economy\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/flight-search/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "flight-search", ""]
						}
					}
				}
			]
		},
		{
			"name": "03. Create Hold Booking",
			"item": [
				{
					"name": "Create Flight Hold Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.booking) {",
									"        pm.environment.set('booking_id', response.data.booking.id);",
									"        pm.environment.set('booking_reference', response.data.booking.booking_reference);",
									"        pm.environment.set('total_amount', response.data.booking.total_amount);",
									"        console.log('Booking created with ID:', response.data.booking.id);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"passengers\": [\n        {\n            \"type\": \"adult\",\n            \"title\": \"Mr\",\n            \"first_name\": \"John\",\n            \"last_name\": \"Doe\",\n            \"gender\": \"M\",\n            \"date_of_birth\": \"1990-01-01\",\n            \"nationality\": \"IN\",\n            \"passport_number\": \"\",\n            \"passport_expiry\": \"\",\n            \"frequent_flyer_number\": \"\"\n        }\n    ],\n    \"flight_offer\": {{flight_offer}},\n    \"contact_email\": \"test@example.com\",\n    \"contact_phone\": \"{{test_phone}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/create-flight-booking/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "create-flight-booking", ""]
						}
					}
				}
			]
		},
		{
			"name": "04. Payment Methods",
			"item": [
				{
					"name": "Get Available Payment Methods",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-payment/methods/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-payment", "methods", ""]
						}
					}
				}
			]
		},
		{
			"name": "05. Payment Processing",
			"item": [
				{
					"name": "Wallet Payment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        console.log('Wallet payment completed successfully');",
									"        pm.environment.set('payment_status', 'PAID');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"payment_method\": \"WALLET\",\n    \"amount\": \"{{total_amount}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-payment/initiate/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-payment", "initiate", ""]
						}
					}
				},
				{
					"name": "PhonePe Payment Initiation",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.payment_url) {",
									"        pm.environment.set('payment_url', response.data.payment_url);",
									"        pm.environment.set('transaction_id', response.data.transaction_id);",
									"        pm.environment.set('merchant_transaction_id', response.data.merchant_transaction_id);",
									"        console.log('PhonePe payment initiated. Payment URL:', response.data.payment_url);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"payment_method\": \"PHONE_PAY\",\n    \"amount\": \"{{total_amount}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-payment/initiate/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-payment", "initiate", ""]
						}
					}
				},
				{
					"name": "PhonePe Payment Success Callback (Simulate)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"merchantTransactionId\": \"{{merchant_transaction_id}}\",\n    \"transactionId\": \"{{transaction_id}}\",\n    \"amount\": {{total_amount}}00,\n    \"state\": \"COMPLETED\",\n    \"responseCode\": \"SUCCESS\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/flight-payment/phonepe-callback/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "flight-payment", "phonepe-callback", ""]
						}
					}
				}
			]
		},
		{
			"name": "06. Booking Management",
			"item": [
				{
					"name": "Get Flight Booking Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-details/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-details", ""]
						}
					}
				},
				{
					"name": "Get Flight Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-status/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-status", ""]
						}
					}
				},
				{
					"name": "Update Flight Status from AirIQ",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-status/update/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-status", "update", ""]
						}
					}
				},
				{
					"name": "Get Booking Timeline",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-timeline/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-timeline", ""]
						}
					}
				},
				{
					"name": "Check Flight Schedule Updates",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-schedule/check/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-schedule", "check", ""]
						}
					}
				}
			]
		},
		{
			"name": "07. User Bookings",
			"item": [
				{
					"name": "Get My Flight Bookings",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/my-flights/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "my-flights", ""]
						}
					}
				},
				{
					"name": "Get My Flight Bookings - With Filters",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/my-flights/?status=CONFIRMED&date_from=2024-12-01&date_to=2024-12-31",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "my-flights", ""],
							"query": [
								{
									"key": "status",
									"value": "CONFIRMED"
								},
								{
									"key": "date_from",
									"value": "2024-12-01"
								},
								{
									"key": "date_to",
									"value": "2024-12-31"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "08. Cancellation & Refunds",
			"item": [
				{
					"name": "Cancel Booking",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Travel plans changed\",\n    \"requested_by\": \"customer\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/cancel-booking/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "cancel-booking", ""]
						}
					}
				},
				{
					"name": "Process Refund",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refund_method\": \"WALLET\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/process-refund/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "process-refund", ""]
						}
					}
				}
			]
		},
		{
			"name": "09. Error Scenarios",
			"item": [
				{
					"name": "Payment with Insufficient Wallet Balance",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"payment_method\": \"WALLET\",\n    \"amount\": \"99999.00\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/{{booking_id}}/flight-payment/initiate/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "{{booking_id}}", "flight-payment", "initiate", ""]
						}
					}
				},
				{
					"name": "Access Non-existent Booking",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/booking/99999/flight-details/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "99999", "flight-details", ""]
						}
					}
				},
				{
					"name": "Invalid Flight Offer Booking",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"passengers\": [],\n    \"flight_offer\": {},\n    \"contact_email\": \"test@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/booking/create-flight-booking/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "booking", "create-flight-booking", ""]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"description": "Base URL for the API"
		}
	]
}